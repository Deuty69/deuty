<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating capsule (requirement 16).

  Layout rules that keep it out of the way:
   * Collapsed = one 34dp pill, wrap_content width, no animation loop.
   * Expanded = fixed 304dp card, so it never covers a full-width form on a
     360dp screen and never grows with content beyond the step list.
   * Every "button" is a TextView with a pill background rather than a themed
     Button: this layout is inflated from a Service context, where the app theme
     is not guaranteed, and framework widgets keep that robust (and cheaper).
   * The STOP control is always visible when a task is live, and is the largest
     touch target in the panel.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed capsule -->
    <LinearLayout
        android:id="@+id/capsule"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/capsule_height"
        android:background="@drawable/bg_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/capsule_padding_h"
        android:paddingEnd="@dimen/space_s"
        android:contentDescription="@string/content_description_drag">

        <View
            android:id="@+id/statusDot"
            android:layout_width="@dimen/dot_size"
            android:layout_height="@dimen/dot_size"
            android:background="@drawable/bg_dot"
            android:contentDescription="@string/content_description_dot" />

        <TextView
            android:id="@+id/capsuleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:ellipsize="end"
            android:maxWidth="190dp"
            android:maxLines="1"
            android:textColor="@color/overlay_text"
            android:textSize="@dimen/text_body"
            tools:text="Working" />

        <TextView
            android:id="@+id/capsuleProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:textColor="@color/overlay_text_dim"
            android:textSize="@dimen/text_caption"
            tools:text="37%" />

        <ImageView
            android:id="@+id/capsuleHandle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/space_xs"
            android:contentDescription="@string/content_description_drag"
            android:src="@drawable/ic_drag"
            android:tint="@color/overlay_text_dim" />
    </LinearLayout>

    <!-- Expanded panel -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="@dimen/panel_padding"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/panelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/panelDot"
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/overlay_title"
                android:textColor="@color/overlay_text"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/collapseButton"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/overlay_collapse"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/overlay_text_dim" />
        </LinearLayout>

        <TextView
            android:id="@+id/panelHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/overlay_text"
            android:textSize="@dimen/text_title"
            tools:text="Moving timetable.pdf" />

        <ProgressBar
            android:id="@+id/panelProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:id="@+id/stepList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/panelAsk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="@color/status_warn"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            tools:text="Your session expired. Log in?"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/optionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical"
            android:visibility="gone" />

        <EditText
            android:id="@+id/panelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_overlay_input"
            android:hint="@string/overlay_reply_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:padding="@dimen/space_s"
            android:textColor="@color/overlay_text"
            android:textColorHint="@color/overlay_text_dim"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/controlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_button"
                android:gravity="center"
                android:text="@string/action_pause"
                android:textColor="@color/overlay_text"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/retryButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_button"
                android:gravity="center"
                android:text="@string/action_retry"
                android:textColor="@color/overlay_text"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1.2"
                android:background="@drawable/bg_overlay_stop"
                android:gravity="center"
                android:text="@string/action_stop"
                android:textColor="@color/overlay_text"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/debugLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:fontFamily="monospace"
            android:textColor="@color/overlay_text_dim"
            android:textSize="@dimen/text_caption"
            android:visibility="gone"
            tools:text="com.android.settings · 214 nodes · tap 240ms"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
