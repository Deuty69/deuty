<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings (requirements 15, 18, 20, 23).

  Also the accessibility service's `settingsActivity`, so it is reachable from
  the system accessibility screen - which is exactly where a user is standing when
  they wonder what this permission actually does. That is why the permission
  status is the first section rather than an afterthought.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_m">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="@dimen/space_s"
            android:src="@drawable/ic_close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m">

            <TextView
                style="@style/Text.Deuty.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_permissions" />

            <LinearLayout
                style="@style/Card.Deuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/accessibilityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="Accessibility: off" />

                <TextView
                    android:id="@+id/overlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="Display over other apps: on" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/openAccessibility"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_s"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingTop="@dimen/space_m"
                        android:paddingBottom="@dimen/space_m"
                        android:text="@string/action_open_accessibility_settings"
                        android:textColor="@color/on_brand"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/openOverlay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingTop="@dimen/space_m"
                        android:paddingBottom="@dimen/space_m"
                        android:text="@string/action_open_overlay_settings"
                        android:textColor="@color/on_brand"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Deuty.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_safety" />

            <LinearLayout
                style="@style/Card.Deuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/confirmMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_confirm_medium_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_confirm_medium_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blockSensitive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pref_block_sensitive_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_block_sensitive_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/allowPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pref_password_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_password_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/askAmbiguous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="Ask when an instruction is ambiguous"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Off: I reply with the list of things I understand. On: I ask a follow-up question instead."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                style="@style/Text.Deuty.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_budgets" />

            <LinearLayout
                style="@style/Card.Deuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_max_actions_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pref_max_actions_summary"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <EditText
                        android:id="@+id/maxActions"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:padding="@dimen/space_s"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        tools:text="60" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pref_max_seconds_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/maxSeconds"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:padding="@dimen/space_s"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pref_max_retries_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/maxRetries"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:padding="@dimen/space_s"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="3" />
            </LinearLayout>

            <TextView
                style="@style/Text.Deuty.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_privacy" />

            <LinearLayout
                style="@style/Card.Deuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/redact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_redact_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_redact_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/keepHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pref_history_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_history_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/allowScreenshots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pref_screenshot_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_screenshot_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                style="@style/Text.Deuty.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_ai" />

            <LinearLayout
                style="@style/Card.Deuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/plannerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="Using Rule-based (offline)." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_ai_provider_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                style="@style/Text.Deuty.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_debug" />

            <LinearLayout
                style="@style/Card.Deuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/debugMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_debug_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_debug_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/logEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pref_log_events_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_log_events_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/openInspector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_m"
                    android:paddingBottom="@dimen/space_m"
                    android:text="@string/title_inspector"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                style="@style/Text.Deuty.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_about" />

            <LinearLayout
                style="@style/Card.Deuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/versionLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="Version 0.1.0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/settings_architecture"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/clearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_m"
                    android:paddingBottom="@dimen/space_m"
                    android:text="@string/pref_clear_history"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/clearWorkflows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_m"
                    android:paddingBottom="@dimen/space_m"
                    android:text="@string/pref_clear_workflows"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/deleteAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_overlay_stop"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_m"
                    android:paddingBottom="@dimen/space_m"
                    android:text="@string/pref_danger_zone"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
