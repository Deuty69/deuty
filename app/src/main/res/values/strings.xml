<resources>
    <string name="app_name">Deuty Agent</string>
    <string name="app_tagline">A tiny assistant that lives on your phone.</string>

    <!-- Accessibility service (shown by the system in Settings) -->
    <string name="accessibility_service_label">Deuty Agent</string>
    <string name="accessibility_service_description">Lets Deuty read the current screen structure and perform taps, swipes and text entry on your behalf, only while a task you started is running.\n\nWhat it does NOT do:\n• It never records your screen continuously.\n• It never uploads screen content (the app has no network permission).\n• It never dismisses Android permission or payment dialogs — it pauses and asks you.\n\nEverything stays on this device. You can turn it off here at any time, which immediately stops the agent.</string>

    <!-- Permissions / onboarding -->
    <string name="perm_title">Two permissions, both on-device</string>
    <string name="perm_accessibility_title">1. Accessibility (the agent\'s hands and eyes)</string>
    <string name="perm_accessibility_body">Used to read the screen structure and to tap, swipe and type. The agent is inert until this is on.</string>
    <string name="perm_overlay_title">2. Display over other apps (the capsule)</string>
    <string name="perm_overlay_body">Shows the floating status capsule with the STOP button while the agent works.</string>
    <string name="perm_restricted_hint">Toggle greyed out or missing? Android 13+ blocks accessibility for sideloaded apps until you tap the ⋮ menu on this screen → “Allow restricted settings”.</string>
    <string name="perm_status_granted">On</string>
    <string name="perm_status_missing">Off</string>
