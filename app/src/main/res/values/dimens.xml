    <!-- Capsule: 34dp tall is enough to read at a glance and small enough that
         it does not cover a toolbar. Collapsed width is wrap_content. -->
    <dimen name="capsule_height">34dp</dimen>
    <dimen name="capsule_radius">17dp</dimen>
    <dimen name="capsule_padding_h">12dp</dimen>
    <dimen name="dot_size">9dp</dimen>

    <!-- Panel stays under 320dp so it never covers a full-width form on a
         360dp screen and remains reachable with one thumb. -->
    <dimen name="panel_width">304dp</dimen>
    <dimen name="panel_radius">20dp</dimen>
    <dimen name="panel_padding">14dp</dimen>

    <dimen name="bubble_radius">14dp</dimen>
    <dimen name="input_radius">22dp</dimen>
    <dimen name="card_radius">14dp</dimen>
