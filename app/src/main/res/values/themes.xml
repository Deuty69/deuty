<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Deuty" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Used for inflating overlay views from a Service context. A Service has
         no theme; without this, inflation resolves attributes against the
         system default and font/colour lookups can fail. -->
    <style name="Theme.Deuty.Overlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
    </style>

    <style name="Text.Deuty.Section" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing" tools:targetApi="21">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">@dimen/space_l</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <style name="Card.Deuty" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>

    <style name="MonoText" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily" tools:targetApi="16">monospace</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
